# Entorno de ejecución
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# PostgreSQL y Auth.js - usa valores secretos únicamente en el gestor de secretos.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tramitexfederal?schema=public"
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Cloudflare Turnstile. Solo la site key puede ser pública.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="replace-with-turnstile-site-key"
TURNSTILE_SECRET_KEY="replace-with-turnstile-secret-key"

# Correo transaccional. Si no se configura Resend, desarrollo registra el enlace sin enviar correo.
EMAIL_PROVIDER=resend
RESEND_API_KEY="replace-with-resend-api-key"
EMAIL_FROM="TramitexFederal <no-reply@example.com>"

# Directorio absoluto, persistente y privado. Nunca usar /public.
DOCUMENT_STORAGE_PATH="C:\\secure-storage\\tramitexfederal"
ALLOWED_ORIGINS="localhost:3000"
HOSTNAME=127.0.0.1
PORT=3000
BACKUP_DIR="C:\\secure-backups\\tramitexfederal"

# Uso único para crear el administrador inicial.
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-password-of-at-least-12-characters"
ADMIN_RESET_EXISTING=false
