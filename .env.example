# Entorno de ejecución
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# PostgreSQL y Auth.js - usa valores secretos únicamente en el gestor de secretos.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tramitexfederal?schema=public"
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Cloudflare Turnstile. Solo la site key puede ser pública.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="replace-with-turnstile-site-key"
TURNSTILE_SECRET_KEY="replace-with-turnstile-secret-key"

# Correo transaccional. Si no se configura Resend, desarrollo registra el enlace sin enviar correo.
EMAIL_PROVIDER=resend
RESEND_API_KEY="replace-with-resend-api-key"
EMAIL_FROM="TramitexFederal <no-reply@example.com>"
# Destino privado para alertas de accesos administrativos e intentos de acceso indebido.
SECURITY_ALERT_EMAIL="security@example.com"

# Almacenamiento privado de documentos (recomendado para Vercel/Hostinger).
# La secret key es server-only: nunca usar NEXT_PUBLIC_ ni exponerla al navegador.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="replace-with-supabase-secret-key"
SUPABASE_STORAGE_BUCKET="documentos-tramites"

# Compatibilidad temporal con proyectos que todavía usan la clave legacy service_role.
# Si usas SUPABASE_SECRET_KEY, no necesitas definir esta variable.
# SUPABASE_SERVICE_ROLE_KEY="replace-with-legacy-service-role-key"

# Alternativa local/autohospedada: ruta absoluta, persistente y privada. Nunca usar /public.
# Si Supabase Storage está configurado, DOCUMENT_STORAGE_PATH no es necesario.
DOCUMENT_STORAGE_PATH="C:\\secure-storage\\tramitexfederal"

ALLOWED_ORIGINS="localhost:3000"
HOSTNAME=127.0.0.1
PORT=3000
BACKUP_DIR="C:\\secure-backups\\tramitexfederal"

# Uso único para crear el administrador inicial.
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-password-of-at-least-12-characters"
ADMIN_RESET_EXISTING=false
