generator client {
  provider   = "prisma-client"
  output     = "../app/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  AGENT
  DATA_ENTRY
  CLIENT
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

enum ProcedureStatus {
  NEW
  WAITING_DOCUMENTS
  UNDER_REVIEW
  DOCUMENTS_COMPLETE
  STARTED
  IN_PROGRESS
  READY_FOR_DELIVERY
  COMPLETED
  ON_HOLD
  REJECTED
  CANCELLED
}

enum DocumentStatus {
  PENDING
  RECEIVED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id                  String                   @id @default(cuid())
  name                String
  email               String                   @unique
  passwordHash        String?
  role                UserRole                 @default(AGENT)
  isActive            Boolean                  @default(true)
  twoFactorEnabled    Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  assignedProcedures  Procedure[]              @relation("ProcedureAssignee")
  client              Client?                  @relation("ClientAccount")
  statusChanges       ProcedureStatusHistory[]
  uploadedDocuments   Document[]               @relation("DocumentUploader")
  reviewedDocuments   Document[]               @relation("DocumentReviewer")
  passwordResetTokens PasswordResetToken[]
  supportMessages     SupportMessage[]
  activityLogs        ActivityLog[]

  @@index([role, isActive])
}

model RoleDefinition {
  id          String           @id @default(cuid())
  role        UserRole         @unique
  name        String
  description String?
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleDefinitionId String
  permissionId     String
  roleDefinition   RoleDefinition @relation(fields: [roleDefinitionId], references: [id], onDelete: Cascade)
  permission       Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleDefinitionId, permissionId])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FolioSequence {
  year      Int      @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Client {
  id             String          @id @default(cuid())
  type           ClientType      @default(INDIVIDUAL)
  firstName      String?
  lastName       String?
  email          String?
  phone          String?
  rfc            String?         @unique
  address        String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  userId         String?         @unique
  company        Company?
  vehicles       Vehicle[]
  procedures     Procedure[]
  documents      Document[]
  supportTickets SupportTicket[]
  user           User?           @relation("ClientAccount", fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, isActive])
  @@index([email])
}

model Company {
  id                  String           @id @default(cuid())
  clientId            String           @unique
  legalName           String
  tradeName           String?
  rfc                 String           @unique
  legalRepresentative String?
  taxAddress          String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  client              Client           @relation(fields: [clientId], references: [id])
  partners            CompanyPartner[]
}

model CompanyPartner {
  id        String   @id @default(cuid())
  companyId String
  fullName  String
  rfc       String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Vehicle {
  id           String      @id @default(cuid())
  clientId     String
  brand        String
  model        String
  year         Int
  vin          String?     @unique
  federalPlate String?     @unique
  invoiceRef   String?
  insuranceRef String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  client       Client      @relation(fields: [clientId], references: [id])
  procedures   Procedure[]

  @@index([clientId])
}

model Service {
  id           String               @id @default(cuid())
  slug         String               @unique
  name         String
  description  String
  isActive     Boolean              @default(true)
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  requirements ServiceRequirement[]
  procedures   Procedure[]
}

model ServiceRequirement {
  id                    String                 @id @default(cuid())
  serviceId             String
  audience              ClientType
  label                 String
  description           String?
  isRequired            Boolean                @default(true)
  sortOrder             Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  service               Service                @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  procedureRequirements ProcedureRequirement[]

  @@unique([serviceId, audience, sortOrder])
}

model Procedure {
  id                 String                   @id @default(cuid())
  folio              String                   @unique
  clientId           String
  vehicleId          String?
  serviceId          String
  assigneeId         String?
  status             ProcedureStatus          @default(NEW)
  publicMessage      String?
  internalNotes      String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  client             Client                   @relation(fields: [clientId], references: [id])
  vehicle            Vehicle?                 @relation(fields: [vehicleId], references: [id])
  service            Service                  @relation(fields: [serviceId], references: [id])
  assignee           User?                    @relation("ProcedureAssignee", fields: [assigneeId], references: [id])
  requirements       ProcedureRequirement[]
  procedureDocuments ProcedureDocument[]
  statusHistory      ProcedureStatusHistory[]
  quote              Quote?
  payments           Payment[]
  supportTickets     SupportTicket[]

  @@index([clientId, status])
  @@index([serviceId, status])
  @@index([status, updatedAt])
}

model ProcedureRequirement {
  id                   String              @id @default(cuid())
  procedureId          String
  serviceRequirementId String?
  label                String
  isRequired           Boolean             @default(true)
  isComplete           Boolean             @default(false)
  notes                String?
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  procedure            Procedure           @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  serviceRequirement   ServiceRequirement? @relation(fields: [serviceRequirementId], references: [id])
  documents            ProcedureDocument[]

  @@index([procedureId, isComplete])
}

model Document {
  id                 String              @id @default(cuid())
  clientId           String?
  uploadedById       String?
  category           String
  originalName       String
  storageKey         String              @unique
  mimeType           String
  sizeBytes          Int
  status             DocumentStatus      @default(PENDING)
  expiresAt          DateTime?
  reviewedAt         DateTime?
  reviewedById       String?
  reviewNotes        String?
  replacesDocumentId String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  client             Client?             @relation(fields: [clientId], references: [id])
  uploadedBy         User?               @relation("DocumentUploader", fields: [uploadedById], references: [id])
  reviewedBy         User?               @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  replacesDocument   Document?           @relation("DocumentReplacement", fields: [replacesDocumentId], references: [id])
  replacements       Document[]          @relation("DocumentReplacement")
  procedures         ProcedureDocument[]

  @@index([clientId, status])
  @@index([uploadedById, createdAt])
  @@index([reviewedById, status])
  @@index([replacesDocumentId])
}

model ProcedureDocument {
  id            String                @id @default(cuid())
  procedureId   String
  documentId    String
  requirementId String?
  createdAt     DateTime              @default(now())
  procedure     Procedure             @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  document      Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requirement   ProcedureRequirement? @relation(fields: [requirementId], references: [id])

  @@unique([procedureId, documentId])
  @@index([requirementId])
}

model ProcedureStatusHistory {
  id            String           @id @default(cuid())
  procedureId   String
  changedById   String?
  fromStatus    ProcedureStatus?
  toStatus      ProcedureStatus
  publicMessage String?
  internalNote  String?
  createdAt     DateTime         @default(now())
  procedure     Procedure        @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  changedBy     User?            @relation(fields: [changedById], references: [id])

  @@index([procedureId, createdAt])
}

model Quote {
  id          String      @id @default(cuid())
  procedureId String      @unique
  subtotal    Decimal     @default(0) @db.Decimal(12, 2)
  tax         Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @default(0) @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  procedure   Procedure   @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  items       QuoteItem[]
}

model QuoteItem {
  id        String   @id @default(cuid())
  quoteId   String
  concept   String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model Payment {
  id              String        @id @default(cuid())
  procedureId     String
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  reference       String?
  proofStorageKey String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  procedure       Procedure     @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([procedureId, status])
  @@index([status, paidAt])
}

model ContactRequest {
  id          String     @id @default(cuid())
  name        String
  phone       String
  email       String
  clientType  ClientType
  serviceSlug String?
  state       String
  message     String
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([isRead, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model SupportTicket {
  id          String              @id @default(cuid())
  clientId    String
  procedureId String?
  subject     String
  status      SupportTicketStatus @default(OPEN)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  procedure   Procedure?          @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  messages    SupportMessage[]

  @@index([clientId, status])
  @@index([procedureId])
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  authorId   String
  body       String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
}
